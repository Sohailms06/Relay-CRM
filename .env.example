# ==============================================================================
# RELAY CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate the values for your environment.
# Note: Never commit secrets or .env.local to Git version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth Credentials
# Found in Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable Client Key (Safe for browser and server)
# Supports both new format (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY) and legacy anon key (NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key-here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key-here"

# Supabase Secret / Service Role Key (STRICTLY SERVER-SIDE ONLY, NEVER EXPOSE TO BROWSER)
# Required for elevated workspace provisioning, administrative audit queries, and system escalation tasks.
# Supports both new format (SUPABASE_SECRET_KEY) and legacy service role key (SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY="your-secret-or-service-role-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-secret-or-service-role-key-here"

# ------------------------------------------------------------------------------
# Future Integration Placeholders (Prompt 2+)
# ------------------------------------------------------------------------------
# Stripe API Keys (Payments)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Twilio SMS / Voice (Lead Ingestion & Escalation Calls)
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+1..."

# Telegram Bot (Lead Ingestion & Staff Alerts)
# TELEGRAM_BOT_TOKEN="..."

# Google Calendar (Appointment Sync)
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
