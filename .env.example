# ==============================================================================
# RELAY CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate the values for your environment.
# Note: Never commit secrets or .env.local to Git version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth Credentials
# Found in Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role Key (Server-side ONLY, never expose to browser)
# Required for elevated workspace provisioning, administrative audit queries, and system escalation tasks.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# Future Integration Placeholders (Prompt 2+)
# ------------------------------------------------------------------------------
# Stripe API Keys (Payments)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Twilio SMS / Voice (Lead Ingestion & Escalation Calls)
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+1..."

# Telegram Bot (Lead Ingestion & Staff Alerts)
# TELEGRAM_BOT_TOKEN="..."

# Google Calendar (Appointment Sync)
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
