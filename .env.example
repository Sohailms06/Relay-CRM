# ==============================================================================
# RELAY CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate the values for your environment.
# Note: Never commit secrets or .env.local to Git version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth Credentials
# Found in Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable Client Key (Safe for browser and server)
# Supports both new format (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY) and legacy anon key (NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key-here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key-here"

# Supabase Secret / Service Role Key (STRICTLY SERVER-SIDE ONLY, NEVER EXPOSE TO BROWSER)
# Required for elevated workspace provisioning, administrative audit queries, and system escalation tasks.
# Supports both new format (SUPABASE_SECRET_KEY) and legacy service role key (SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY="your-secret-or-service-role-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-secret-or-service-role-key-here"

# ------------------------------------------------------------------------------
# Phase 3 External Integrations
# ------------------------------------------------------------------------------
# Telegram Bot (Escalation Alerts & Outbox)
# Create bot via @BotFather, get Chat ID via @userinfobot or channel ID
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# Twilio (WhatsApp Sandbox & SMS Ingestion)
# Found in Twilio Console
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="+14155238886"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# Stripe (Test Mode Payments & Webhooks)
# Found in Stripe Dashboard -> Developers -> API Keys / Webhooks
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51..."

# Google Calendar (OAuth 2.0 & Appointment Booking)
# Found in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="https://relay-crm-neon.vercel.app/api/auth/google/callback"

